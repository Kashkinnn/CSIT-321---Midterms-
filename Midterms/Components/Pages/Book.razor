@page "/book"
@implements IBookingView
@inject IWonderRepository Repo

<PageTitle>Book a Tour - Wonders</PageTitle>

<section class="relative min-h-screen pt-36 pb-24 px-6">
    <div class="max-w-6xl mx-auto">
        <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">Reserve your spot</p>
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mt-3">Book a tour package</h1>
        <p class="text-white/55 mt-4 max-w-xl">Pick a destination, choose your dates, and we'll handle the rest. Free cancellation up to 14 days before departure.</p>

        @if (_confirmation is not null)
        {
            <div class="mt-12 max-w-xl glass rounded-[2rem] p-10 fade-up">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-amber-300 to-rose-500 flex items-center justify-center text-black text-2xl font-bold">&check;</div>
                <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase mt-6">Booking confirmed</p>
                <p class="text-4xl font-extrabold tracking-tight mt-1">@_reference</p>
                <p class="text-white/70 mt-4 leading-relaxed">@_confirmation</p>
                <button @onclick="Reset" class="btn-primary mt-8">Book another tour</button>
            </div>
        }
        else
        {
            <div class="grid lg:grid-cols-5 gap-10 mt-12">
                <EditForm Model="_request" OnValidSubmit="Submit" class="lg:col-span-3 glass rounded-[2rem] p-6 md:p-10 space-y-6">
                    <DataAnnotationsValidator />

                    <div class="grid sm:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-widest mb-2 text-white/50">Full name</label>
                            <InputText @bind-Value="_request.FullName" class="field" placeholder="Juan Dela Cruz" />
                            <ValidationMessage For="() => _request.FullName" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-widest mb-2 text-white/50">Email</label>
                            <InputText @bind-Value="_request.Email" class="field" placeholder="you@email.com" />
                            <ValidationMessage For="() => _request.Email" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-widest mb-2 text-white/50">Destination</label>
                        <InputSelect TValue="int" @bind-Value="_request.WonderId" @bind-Value:after="Recalculate" class="field">
                            @foreach (var w in _wonders)
                            {
                                <option value="@w.Id">@w.Name - @w.Country ($@w.PricePerPerson.ToString("N0") / person)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => _request.WonderId" />
                    </div>

                    <div class="grid sm:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-widest mb-2 text-white/50">Travel date</label>
                            <InputDate TValue="DateTime?" @bind-Value="_request.TravelDate" class="field" />
                            <ValidationMessage For="() => _request.TravelDate" />
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-widest mb-2 text-white/50">Travelers</label>
                            <InputNumber TValue="int" @bind-Value="_request.Travelers" @bind-Value:after="Recalculate" class="field" />
                            <ValidationMessage For="() => _request.Travelers" />
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-widest mb-2 text-white/50">Special requests <span class="normal-case tracking-normal text-white/30">(optional)</span></label>
                        <InputTextArea @bind-Value="_request.Notes" class="field" rows="3" placeholder="Dietary needs, accessibility, celebrations..." />
                    </div>

                    <button type="submit" class="btn-primary w-full md:w-auto">Confirm booking &rarr;</button>
                </EditForm>

                @* Summary *@
                <aside class="lg:col-span-2">
                    @if (_selected is not null)
                    {
                        <div @key="_selected.Id" class="fade-up lg:sticky lg:top-28 rounded-[2rem] overflow-hidden glass">
                            <div class="relative">
                                <img src="@_selected.Image" alt="@_selected.Name" class="h-60 w-full object-cover" />
                                <div class="absolute inset-0 bg-gradient-to-t from-[#07090d] via-transparent to-transparent"></div>
                                <span class="absolute top-4 left-4 glass rounded-full px-3 py-1.5 text-xs font-semibold">@_selected.Days days</span>
                            </div>
                            <div class="p-7 -mt-8 relative">
                                <p class="text-grad text-xs font-bold tracking-[0.2em] uppercase">@_selected.Country</p>
                                <h3 class="text-2xl font-extrabold tracking-tight mt-1">@_selected.Name</h3>
                                <p class="text-sm text-white/60 mt-3 leading-relaxed">@_selected.Description</p>

                                <div class="mt-6 space-y-2 text-sm">
                                    <div class="flex justify-between text-white/60">
                                        <span>$@_selected.PricePerPerson.ToString("N0") x @_request.Travelers traveler(s)</span>
                                        <span>$@_total.ToString("N0")</span>
                                    </div>
                                    <div class="flex justify-between text-white/60">
                                        <span>Best time to go</span>
                                        <span>@_selected.BestTime</span>
                                    </div>
                                </div>

                                <div class="mt-5 pt-5 border-t border-white/10 flex justify-between items-end">
                                    <span class="text-white/50 text-sm">Total</span>
                                    <span class="text-4xl font-extrabold tracking-tight text-grad">$@_total.ToString("N0")</span>
                                </div>
                            </div>
                        </div>
                    }
                </aside>
            </div>
        }
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "wonder")] public int? WonderQuery { get; set; }

    private BookingPresenter _presenter = default!;
    private readonly BookingRequest _request = new();
    private IReadOnlyList<Wonder> _wonders = new List<Wonder>();
    private Wonder? _selected;
    private decimal _total;
    private string? _confirmation;
    private string? _reference;

    protected override void OnInitialized()
    {
        _presenter = new BookingPresenter(this, Repo);
        _presenter.Load();
        _request.WonderId = WonderQuery is > 0 ? WonderQuery.Value : _wonders[0].Id;
        Recalculate();
    }

    private void Recalculate()
    {
        _selected = Repo.GetById(_request.WonderId);
        _presenter.RecalculateTotal(_request);
    }

    private void Submit() => _presenter.Submit(_request);

    private void Reset()
    {
        _confirmation = null;
        _request.FullName = _request.Email = _request.Notes = "";
        _request.Travelers = 2;
        Recalculate();
    }

    // IBookingView
    public void ShowWonders(IReadOnlyList<Wonder> wonders) => _wonders = wonders;
    public void ShowTotal(decimal total) => _total = total;
    public void ShowConfirmation(string reference, string message)
    {
        _reference = reference;
        _confirmation = message;
    }
}
