@page "/wonder/{Id:int}"
@implements IWonderDetailView
@inject IWonderRepository Repo

@if (_wonder is null)
{
    <PageTitle>Not found - Wonders</PageTitle>
    <section class="min-h-screen flex items-center justify-center px-6 text-center">
        <div>
            <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">404</p>
            <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mt-3">Wonder not found</h1>
            <a href="/" class="btn-primary mt-8">Back to explore</a>
        </div>
    </section>
}
else
{
    <PageTitle>@_wonder.Name - Wonders</PageTitle>

    @* Hero *@
    <section class="relative h-[78vh] min-h-[32rem] flex items-end overflow-hidden">
        <img src="@_wonder.Image" alt="@_wonder.Name" class="absolute inset-0 w-full h-full object-cover scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#07090d] via-black/40 to-black/50"></div>
        <div @key="_wonder.Id" class="fade-up relative max-w-6xl mx-auto w-full px-6 pb-14">
            <div class="mb-6">
                <a href="/" class="btn-ghost !py-2 !px-4 text-xs">&larr; All wonders</a>
            </div>
            <div class="flex flex-wrap gap-2 mb-4">
                <span class="glass rounded-full px-3 py-1.5 text-xs font-semibold">@_wonder.Country</span>
                <span class="glass rounded-full px-3 py-1.5 text-xs font-semibold">@_wonder.Region</span>
                <span class="glass rounded-full px-3 py-1.5 text-xs font-semibold">@_wonder.Category</span>
            </div>
            <h1 class="text-5xl md:text-7xl font-extrabold tracking-tighter leading-[1.02] max-w-4xl">@_wonder.Name</h1>
            <p class="text-lg md:text-xl text-white/75 mt-4 max-w-2xl">@_wonder.Tagline</p>
            <div class="flex flex-wrap gap-3 mt-8">
                <a href="book?wonder=@_wonder.Id" class="btn-primary">Book this tour &rarr;</a>
                <button type="button" class="btn-ghost" onclick="document.getElementById('history').scrollIntoView({behavior:'smooth'})">Read the story</button>
            </div>
        </div>
    </section>

    <div class="max-w-6xl mx-auto px-6 pb-24">

        @* Section nav *@
        <div class="sticky top-24 z-30 -mt-7 mb-12 flex justify-center">
            <div class="glass-dark rounded-full p-1.5 flex gap-1 shadow-2xl shadow-black/40">
                <button type="button" class="px-4 py-2 rounded-full text-sm font-semibold text-white/80 hover:text-white hover:bg-white/10 transition"
                        onclick="document.getElementById('history').scrollIntoView({behavior:'smooth'})">History</button>
                <button type="button" class="px-4 py-2 rounded-full text-sm font-semibold text-white/80 hover:text-white hover:bg-white/10 transition"
                        onclick="document.getElementById('highlights').scrollIntoView({behavior:'smooth'})">Highlights</button>
                <button type="button" class="px-4 py-2 rounded-full text-sm font-semibold text-white/80 hover:text-white hover:bg-white/10 transition"
                        onclick="document.getElementById('visit').scrollIntoView({behavior:'smooth'})">Plan your visit</button>
            </div>
        </div>

        @* Stat strip *@
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
            <div class="glass rounded-3xl p-6">
                <p class="text-xs uppercase tracking-widest text-white/45">Built</p>
                <p class="text-lg font-bold mt-2 text-grad">@_wonder.Built</p>
            </div>
            <div class="glass rounded-3xl p-6">
                <p class="text-xs uppercase tracking-widest text-white/45">UNESCO listed</p>
                <p class="text-lg font-bold mt-2 text-grad">@_wonder.UnescoYear</p>
            </div>
            <div class="glass rounded-3xl p-6">
                <p class="text-xs uppercase tracking-widest text-white/45">Best time</p>
                <p class="text-lg font-bold mt-2 text-grad">@_wonder.BestTime</p>
            </div>
            <div class="glass rounded-3xl p-6">
                <p class="text-xs uppercase tracking-widest text-white/45">Tour length</p>
                <p class="text-lg font-bold mt-2 text-grad">@_wonder.Days days</p>
            </div>
        </div>

        <div class="grid lg:grid-cols-3 gap-12">

            @* Main column *@
            <div class="lg:col-span-2 space-y-20">

                <section id="history" class="scroll-mt-40">
                    <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">The story</p>
                    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">About @_wonder.Name</h2>
                    <p class="text-white/55 mt-2 text-sm">@_wonder.Location</p>
                    <p class="text-lg text-white/80 leading-relaxed mt-6">@_wonder.Description</p>
                    @foreach (var p in _wonder.History)
                    {
                        <p class="text-white/65 leading-relaxed mt-5">@p</p>
                    }
                </section>

                <section id="highlights" class="scroll-mt-40">
                    <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">Don't miss</p>
                    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Highlights</h2>
                    <div class="grid sm:grid-cols-2 gap-4 mt-8">
                        @for (var i = 0; i < _wonder.Highlights.Count; i++)
                        {
                            var h = _wonder.Highlights[i];
                            <div class="glass rounded-3xl p-6 card-lift">
                                <span class="text-sm font-bold text-grad">@((i + 1).ToString("00"))</span>
                                <h3 class="text-lg font-bold mt-2">@h.Title</h3>
                                <p class="text-sm text-white/60 leading-relaxed mt-2">@h.Text</p>
                            </div>
                        }
                    </div>
                </section>

                <section id="visit" class="scroll-mt-40">
                    <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">Before you go</p>
                    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Plan your visit</h2>

                    <div class="grid sm:grid-cols-2 gap-4 mt-8">
                        <div class="glass rounded-3xl p-6">
                            <p class="text-xs uppercase tracking-widest text-white/45">Getting there</p>
                            <p class="text-sm text-white/75 leading-relaxed mt-3">@_wonder.GettingThere</p>
                        </div>
                        <div class="glass rounded-3xl p-6">
                            <p class="text-xs uppercase tracking-widest text-white/45">Nearest airport</p>
                            <p class="text-sm text-white/75 leading-relaxed mt-3">@_wonder.NearestAirport</p>
                            <p class="text-xs uppercase tracking-widest text-white/45 mt-5">Best time to visit</p>
                            <p class="text-sm text-white/75 mt-2">@_wonder.BestTime</p>
                        </div>
                    </div>

                    <div class="glass rounded-3xl p-6 mt-4">
                        <p class="text-xs uppercase tracking-widest text-white/45 mb-4">Insider tips</p>
                        <ul class="space-y-3">
                            @foreach (var t in _wonder.Tips)
                            {
                                <li class="flex gap-3 text-sm text-white/75 leading-relaxed">
                                    <span class="mt-1.5 w-1.5 h-1.5 shrink-0 rounded-full bg-gradient-to-br from-amber-300 to-rose-500"></span>
                                    <span>@t</span>
                                </li>
                            }
                        </ul>
                    </div>
                </section>
            </div>

            @* Sidebar *@
            <aside class="space-y-6">
                <div class="lg:sticky lg:top-44 space-y-6">
                    <div class="glass rounded-[2rem] p-7">
                        <p class="text-xs uppercase tracking-widest text-white/45">From</p>
                        <p class="text-4xl font-extrabold tracking-tight text-grad mt-1">$@_wonder.PricePerPerson.ToString("N0")</p>
                        <p class="text-sm text-white/55">per person &middot; @_wonder.Days days</p>

                        <ul class="mt-6 space-y-2 text-sm text-white/75">
                            @foreach (var item in _included)
                            {
                                <li class="flex gap-2"><span class="text-amber-300">&check;</span> @item</li>
                            }
                        </ul>

                        <a href="book?wonder=@_wonder.Id" class="btn-primary w-full mt-7">Book this tour &rarr;</a>
                    </div>

                    <div class="glass rounded-[2rem] p-7">
                        <p class="text-xs uppercase tracking-widest text-white/45 mb-4">Quick facts</p>
                        <dl class="space-y-3 text-sm">
                            @foreach (var f in _wonder.Facts)
                            {
                                <div class="flex justify-between gap-4 border-b border-white/5 pb-3 last:border-0 last:pb-0">
                                    <dt class="text-white/50">@f.Label</dt>
                                    <dd class="font-semibold text-right">@f.Value</dd>
                                </div>
                            }
                        </dl>
                    </div>
                </div>
            </aside>
        </div>

        @* Related *@
        <section class="mt-28">
            <div class="flex items-end justify-between mb-8">
                <div>
                    <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">Keep exploring</p>
                    <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">More wonders</h2>
                </div>
            </div>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var w in _related)
                {
                    <a @key="w.Id" href="wonder/@w.Id" class="card-lift group relative h-80 rounded-[2rem] overflow-hidden">
                        <img src="@w.Image" alt="@w.Name" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-1000" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
                        <div class="absolute bottom-0 inset-x-0 p-6">
                            <p class="text-grad text-xs font-bold tracking-[0.2em] uppercase">@w.Country</p>
                            <h3 class="text-xl font-extrabold tracking-tight mt-1">@w.Name</h3>
                        </div>
                    </a>
                }
            </div>
        </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private WonderDetailPresenter _presenter = default!;
    private Wonder? _wonder;
    private IReadOnlyList<Wonder> _related = new List<Wonder>();

    private static readonly string[] _included =
    {
        "Licensed local guide",
        "Hotel accommodation",
        "Airport transfers",
        "Entrance tickets",
        "Daily breakfast",
        "Small groups (max 12)",
    };

    protected override void OnInitialized() => _presenter = new WonderDetailPresenter(this, Repo);

    protected override void OnParametersSet() => _presenter.Load(Id);

    // IWonderDetailView
    public void ShowWonder(Wonder wonder) => _wonder = wonder;
    public void ShowRelated(IReadOnlyList<Wonder> related) => _related = related;
    public void ShowNotFound() => _wonder = null;
}
