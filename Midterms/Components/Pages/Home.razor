@page "/"
@implements IHomeView
@implements IAsyncDisposable
@inject IWonderRepository Repo
@inject IJSRuntime JS

<PageTitle>Wonders - Explore the New 7 Wonders</PageTitle>

<section id="hero" class="relative" style="height:@(_wonders.Count * 110)vh">
    <div class="sticky top-0 h-screen overflow-hidden">

        @* Background layers *@
        @for (var i = 0; i < _wonders.Count; i++)
        {
            <div class="absolute inset-0 bg-cover bg-center transition-all duration-[1400ms] ease-out @(i == _active ? "opacity-100 scale-100" : "opacity-0 scale-110")"
                 style="background-image:url('@_wonders[i].Image')"></div>
        }
        <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/20 to-[#07090d]"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/40 via-transparent to-black/20"></div>

        <div class="relative z-10 h-full flex flex-col justify-between pt-28 pb-6 px-4 md:px-12">

            @* Slices *@
            <div class="flex justify-center items-end gap-2 md:gap-3 h-[34vh] md:h-[38vh]">
                @for (var i = 0; i < _wonders.Count; i++)
                {
                    var idx = i;
                    var w = _wonders[i];
                    var isActive = i == _active;
                    <button @onclick="() => ScrollToWonder(idx)"
                            class="group relative overflow-hidden rounded-2xl transition-all duration-700 ease-out h-full
                                   @(isActive ? "w-32 sm:w-44 md:w-64 -translate-y-3 ring-2 ring-white/90 shadow-[0_25px_70px_-15px_rgba(251,146,60,.65)]" : "w-14 sm:w-24 md:w-36 opacity-60 hover:opacity-100 hover:-translate-y-1")">
                        <img src="@w.Image" alt="@w.Name" class="absolute inset-0 w-full h-full object-cover transition duration-700 group-hover:scale-110" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/10 to-black/20"></div>
                        <span class="absolute inset-0 flex items-center justify-center text-[10px] md:text-xs font-semibold tracking-[0.3em] uppercase [writing-mode:vertical-rl] rotate-180">
                            @w.Category
                        </span>
                        @if (isActive)
                        {
                            <span class="absolute top-3 left-3 text-xs font-bold glass rounded-full px-2.5 py-1">@((idx + 1).ToString("00"))</span>
                        }
                    </button>
                }
            </div>

            @* Big title *@
            <h1 class="text-center font-extrabold leading-[0.85] tracking-tighter select-none pointer-events-none
                       text-[clamp(3.5rem,14vw,12rem)] text-white drop-shadow-[0_10px_40px_rgba(0,0,0,.5)]">
                WONDERS
            </h1>

            @* Details *@
            @if (_wonders.Count > 0)
            {
                var cur = _wonders[_active];
                <div @key="_active" class="fade-up glass-dark relative isolate overflow-hidden rounded-3xl p-5 md:p-7 grid md:grid-cols-12 gap-5 md:gap-8 items-center shadow-2xl">
                    <div class="absolute inset-0 -z-10 bg-cover bg-center scale-125 blur-2xl opacity-70" style="background-image:url('@cur.Image')"></div>
                    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-black/20 to-black/50"></div>

                    <div class="md:col-span-3">
                        <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">@cur.Country</p>
                        <h2 class="text-2xl md:text-3xl font-extrabold tracking-tight mt-1">@cur.Name</h2>
                    </div>
                    <p class="md:col-span-5 text-sm md:text-[15px] text-white/85 leading-relaxed">@cur.Description</p>
                    <div class="md:col-span-4 flex items-center justify-between md:justify-end gap-5">
                        <div class="text-xs text-white/70 space-y-1">
                            <p><span class="text-white font-semibold">Built</span> &nbsp;@cur.Built</p>
                            <p><span class="text-white font-semibold">Best time</span> &nbsp;@cur.BestTime</p>
                        </div>
                        <a href="book?wonder=@cur.Id" class="btn-primary shrink-0">Book this tour &rarr;</a>
                    </div>
                </div>
            }
        </div>

        @* Counter *@
        <div class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-20 flex flex-col items-center gap-3 text-xs font-semibold">
            <span class="text-white">@((_active + 1).ToString("00"))</span>
            <div class="flex flex-col gap-2">
                @for (var i = 0; i < _wonders.Count; i++)
                {
                    <span class="block w-1.5 rounded-full transition-all duration-500 @(i == _active ? "h-8 bg-gradient-to-b from-amber-300 to-rose-500" : "h-1.5 bg-white/30")"></span>
                }
            </div>
            <span class="text-white/40">@_wonders.Count.ToString("00")</span>
        </div>

        @* Scroll hint *@
        <div class="hidden md:flex absolute left-8 top-1/2 -translate-y-1/2 z-20 flex-col items-center gap-3">
            <span class="text-[10px] tracking-[0.35em] uppercase text-white/60 [writing-mode:vertical-rl] rotate-180">Scroll to explore</span>
            <span class="block w-px h-12 bg-white/50 scroll-line"></span>
        </div>
    </div>
</section>

@* Highlights *@
<section class="max-w-6xl mx-auto px-6 pt-24">
    <div class="grid sm:grid-cols-3 gap-4">
        @foreach (var f in _features)
        {
            <div class="glass rounded-3xl p-7">
                <p class="text-4xl font-extrabold text-grad">@f.Value</p>
                <p class="font-semibold mt-3">@f.Title</p>
                <p class="text-sm text-white/55 mt-1">@f.Text</p>
            </div>
        }
    </div>
</section>

<section class="max-w-6xl mx-auto px-6 py-24">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-12">
        <div>
            <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">Tour packages</p>
            <h2 class="text-4xl md:text-5xl font-extrabold tracking-tight mt-3">Choose your wonder</h2>
        </div>
        <a href="book" class="btn-ghost self-start md:self-auto">View all &amp; book &rarr;</a>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var w in _wonders)
        {
            <a href="book?wonder=@w.Id" class="card-lift group relative h-[26rem] rounded-[2rem] overflow-hidden">
                <img src="@w.Image" alt="@w.Name" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition duration-1000" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent"></div>
                <span class="absolute top-5 left-5 glass rounded-full px-3 py-1.5 text-xs font-semibold">@w.Days days</span>
                <span class="absolute top-5 right-5 glass rounded-full px-3 py-1.5 text-xs font-semibold">@w.Category</span>
                <div class="absolute bottom-0 inset-x-0 p-6">
                    <p class="text-grad text-xs font-bold tracking-[0.2em] uppercase">@w.Country</p>
                    <h3 class="text-2xl font-extrabold tracking-tight mt-1">@w.Name</h3>
                    <div class="flex items-center justify-between mt-3">
                        <p class="text-sm text-white/70">From <span class="text-white font-bold">$@w.PricePerPerson.ToString("N0")</span> / person</p>
                        <span class="w-9 h-9 rounded-full bg-white text-black flex items-center justify-center group-hover:bg-amber-300 transition">&rarr;</span>
                    </div>
                </div>
            </a>
        }
    </div>
</section>

@code {
    private HomePresenter _presenter = default!;
    private DotNetObjectReference<Home>? _ref;
    private IReadOnlyList<Wonder> _wonders = new List<Wonder>();
    private int _active;

    private readonly List<(string Value, string Title, string Text)> _features = new()
    {
        ("5", "Iconic destinations", "Hand-picked wonders across four continents."),
        ("12k+", "Happy travelers", "Join thousands who explored with us."),
        ("24/7", "Local support", "Expert guides and help on the ground."),
    };

    protected override void OnInitialized()
    {
        _presenter = new HomePresenter(this, Repo);
        _presenter.Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _ref = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("wondersScroll.init", _ref, "hero", _wonders.Count);
    }

    [JSInvokable]
    public void OnScrollIndex(int index)
    {
        _presenter.OnScrollIndexChanged(index);
        InvokeAsync(StateHasChanged);
    }

    private async Task ScrollToWonder(int index) =>
        await JS.InvokeVoidAsync("wondersScroll.scrollTo", "hero", _wonders.Count, index);

    // IHomeView
    public void ShowWonders(IReadOnlyList<Wonder> wonders) => _wonders = wonders;
    public void ShowActiveWonder(int index) => _active = index;

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("wondersScroll.dispose"); }
        catch (JSDisconnectedException) { }
        _ref?.Dispose();
    }
}