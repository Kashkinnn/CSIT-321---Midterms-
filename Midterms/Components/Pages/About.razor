@page "/about"
@implements IAboutView

<PageTitle>About &amp; Contact - Wonders</PageTitle>

<section class="relative h-[70vh] flex items-end overflow-hidden">
    <img src="images/taj-mahal.jpg" alt="Taj Mahal" class="absolute inset-0 w-full h-full object-cover scale-105" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#07090d] via-black/40 to-black/50"></div>
    <div class="relative max-w-6xl mx-auto w-full px-6 pb-16 fade-up">
        <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">About us</p>
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tighter mt-3 max-w-3xl leading-[1.02]">Travel that <span class="text-grad">moves</span> you.</h1>
    </div>
</section>

<section class="max-w-6xl mx-auto px-6 py-24 grid md:grid-cols-2 gap-14 items-center">
    <div>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight">Our story</h2>
        <p class="text-white/65 leading-relaxed mt-5">
            Wonders began with one question: why settle for postcards? We craft guided journeys to the world's most
            iconic landmarks, led by local experts who know the stories behind the stones. From the Great Wall at
            sunrise to Machu Picchu in the mist, every itinerary is built around time, comfort, and awe.
        </p>
        <p class="text-white/65 leading-relaxed mt-4">
            Small groups, honest pricing, and guides who live where you travel. That's the promise.
        </p>
        <div class="grid grid-cols-2 gap-4 mt-8">
            @foreach (var s in _stats)
            {
                <div class="glass rounded-3xl p-6">
                    <p class="text-3xl font-extrabold text-grad">@s.Value</p>
                    <p class="text-sm text-white/55 mt-1">@s.Label</p>
                </div>
            }
        </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
        <img src="images/petra.jpg" alt="Petra" class="rounded-[2rem] h-72 w-full object-cover mt-10" />
        <img src="images/machu-picchu.jpg" alt="Machu Picchu" class="rounded-[2rem] h-72 w-full object-cover" />
        <img src="images/great-wall.jpg" alt="Great Wall" class="rounded-[2rem] h-56 w-full object-cover col-span-2" />
    </div>
</section>

<section class="max-w-6xl mx-auto px-6 pb-28 grid lg:grid-cols-5 gap-10">
    <div class="lg:col-span-2">
        <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase">Contact</p>
        <h2 class="text-3xl md:text-4xl font-extrabold tracking-tight mt-3">Get in touch</h2>
        <p class="text-white/60 mt-4">Questions about a package or a custom trip? Send us a note and we'll reply within a day.</p>

        <div class="mt-8 space-y-3">
            @foreach (var c in _contacts)
            {
                <div class="glass rounded-2xl px-5 py-4">
                    <p class="text-xs uppercase tracking-widest text-white/40">@c.Label</p>
                    <p class="font-semibold mt-0.5">@c.Value</p>
                </div>
            }
        </div>
    </div>

    <div class="lg:col-span-3">
        @if (_result is not null)
        {
            <div class="glass rounded-[2rem] p-10 fade-up">
                <div class="w-14 h-14 rounded-full bg-gradient-to-br from-amber-300 to-rose-500 flex items-center justify-center text-black text-2xl font-bold">&check;</div>
                <p class="text-grad text-xs font-bold tracking-[0.25em] uppercase mt-6">Message sent</p>
                <p class="mt-3 text-white/75 leading-relaxed">@_result</p>
                <button @onclick="() => _result = null" class="btn-primary mt-8">Send another</button>
            </div>
        }
        else
        {
            <EditForm Model="_message" OnValidSubmit="Send" class="glass rounded-[2rem] p-6 md:p-10 space-y-6">
                <DataAnnotationsValidator />
                <div class="grid sm:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-widest mb-2 text-white/50">Name</label>
                        <InputText @bind-Value="_message.Name" class="field" placeholder="Your name" />
                        <ValidationMessage For="() => _message.Name" />
                    </div>
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-widest mb-2 text-white/50">Email</label>
                        <InputText @bind-Value="_message.Email" class="field" placeholder="you@email.com" />
                        <ValidationMessage For="() => _message.Email" />
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold uppercase tracking-widest mb-2 text-white/50">Message</label>
                    <InputTextArea @bind-Value="_message.Message" class="field" rows="5" placeholder="Tell us about your dream trip..." />
                    <ValidationMessage For="() => _message.Message" />
                </div>
                <button type="submit" class="btn-primary">Send message &rarr;</button>
            </EditForm>
        }
    </div>
</section>

@code {
    private AboutPresenter _presenter = default!;
    private readonly ContactMessage _message = new();
    private IReadOnlyList<(string Label, string Value)> _stats = new List<(string, string)>();
    private string? _result;

    private readonly List<(string Label, string Value)> _contacts = new()
    {
        ("Email", "hello@wonders-tours.com"),
        ("Phone", "+63 900 000 0000"),
        ("Office", "Cebu City, Philippines"),
        ("Hours", "Mon - Sat, 9:00 AM - 6:00 PM"),
    };

    protected override void OnInitialized()
    {
        _presenter = new AboutPresenter(this);
        _presenter.Load();
    }

    private void Send() => _presenter.SendMessage(_message);

    // IAboutView
    public void ShowStats(IReadOnlyList<(string Label, string Value)> stats) => _stats = stats;
    public void ShowContactResult(string message)
    {
        _result = message;
        _message.Name = _message.Email = _message.Message = "";
    }
}
